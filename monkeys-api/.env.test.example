# Variables para pruebas e2e. Copia este archivo a `.env.test` (gitignoreado).
#
#   cp .env.test.example .env.test
#
# Apunta a la Postgres desechable de docker-compose.test.yml (localhost:5433).
#
# ⚠️ NUNCA pongas aquí credenciales de producción. Los tests hacen TRUNCATE de
#    TODAS las tablas en cada corrida — apuntar a prod borraría la base entera.
#    Los guardarraíles (test/load-test-env.ts y test/global-setup.ts) abortan
#    si la URL no es exactamente la DB de test local.
#
# Las migraciones de Prisma leen DATABASE_URL (ver prisma.config.ts).
# El runtime (PrismaService) lee DATABASE_URL_SESSION. Las tres apuntan al
# mismo contenedor local.

DATABASE_URL="postgresql://veritt_test:veritt_test@localhost:5433/veritt_test"
DATABASE_URL_SESSION="postgresql://veritt_test:veritt_test@localhost:5433/veritt_test"
DATABASE_URL_DIRECT="postgresql://veritt_test:veritt_test@localhost:5433/veritt_test"

JWT_SECRET="test-secret"
PORT=3001
