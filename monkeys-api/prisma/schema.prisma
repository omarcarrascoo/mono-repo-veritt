generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

// Roles R1–R6 (V8.0): posiciones en la cadena operativa, no niveles de acceso.
// Ver ROLES_R1_R6_MATRIX.md para la matriz de permisos completa.
enum MembershipRole {
  R1_INVENTORY // Encargado de Inventario (FAI/FCI, recepciones)
  R2_CASH      // Encargado de Caja (saldo inicial, FAF)
  R3_POS       // Operador POS (comandar)
  R4_MANAGER   // Gerente de Turno (autoriza, firma FOP)
  R5_ADMIN     // Administrador (facturas, CxP, OCs, gastos)
  R6_OWNER     // Dueño (acceso total)
  VERITT_STAFF // Staff interno Veritt (bypass, soporte)
}

enum MembershipStatus {
  ACTIVE
  INVITED
  INACTIVE
}

enum OnboardingStatus {
  DRAFT
  IN_PROGRESS
  READY
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum PayrollFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
}

enum PayrollPaymentStatus {
  PENDING
  PAID
  OVERDUE
  SKIPPED
  CANCELED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum NotificationType {
  PAYROLL_DUE
  PAYROLL_OVERDUE
  MATERIAL_LOW_STOCK
  MATERIAL_OUT_OF_STOCK
  PRODUCT_LOW_STOCK
  PRODUCT_OUT_OF_STOCK
  PRICE_ALERT
  DAILY_OPENING_PENDING
  DAILY_DEVIATION_ALERT
  DAILY_RECONCILIATION_DISCREPANCY
  DAILY_CHAIN_BLOCKED
}

enum SystemAccessLevel {
  NONE
  OPERATOR
  SUPERVISOR
  ADMIN
}

enum InventoryLocationType {
  MAIN
  WAREHOUSE
  RESTAURANT
  KITCHEN
  OTHER
}

enum InventoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductType {
  DIRECT
  RECIPE
}

// RAW: insumo que se compra a proveedor (harina, carne cruda).
// TRANSFORMED: insumo semi-elaborado producido internamente vía FTI
// (carne marinada, aderezos). Puede usarse en recetas de productos.
enum MaterialKind {
  RAW
  TRANSFORMED
}

enum InventoryMovementType {
  OPENING_BALANCE
  PURCHASE
  RECEIPT
  PRODUCTION_IN
  PRODUCTION_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  SALE
  RETURN
  WASTE
}

enum InventoryLotSourceType {
  OPENING_BALANCE
  PURCHASE
  RECEIPT
  TRANSFER
  PRODUCTION
  ADJUSTMENT
}

// ──────────────────────────────────────────────
// Phase 1 enums: Areas, Processes, Time Tracking
// ──────────────────────────────────────────────

enum AreaType {
  KITCHEN
  BAR
  DINING
  CASH_REGISTER
  WAREHOUSE
  OFFICE
  PRODUCTION
  OTHER
}

enum AreaStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProcessStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProcessExecutionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ShiftLogStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ShiftBreakType {
  MEAL
  REST
  OTHER
}

enum PermissionAction {
  READ
  EXECUTE
  APPROVE
  MANAGE
}

// ──────────────────────────────────────────────
// Phase 2 enums: Sales & POS
// ──────────────────────────────────────────────

enum PaymentMethodType {
  CASH
  CARD_TERMINAL
  BANK_TRANSFER
  OTHER
}

enum PaymentMethodStatus {
  ACTIVE
  INACTIVE
}

enum SaleStatus {
  OPEN
  COMPLETED
  CANCELLED
  REFUNDED
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  fullName     String
  status       UserStatus           @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships      BusinessMembership[]
  businesses       Business[]           @relation("BusinessCreator")
  purchaseOrders     PurchaseOrder[]      @relation("PurchaseOrderCreator")
  receiptsReceived   Receipt[]            @relation("ReceiptReceiver")
  receiptsCancelled  Receipt[]            @relation("ReceiptCanceller")
  receiptsAuthorized Receipt[]            @relation("ReceiptAuthorizer")
  receiptsRejected   Receipt[]            @relation("ReceiptRejecter")
  invoicesVerified   SupplierInvoice[]    @relation("InvoiceVerifier")
  invoicesDeleted    SupplierInvoice[]    @relation("InvoiceDeleter")
}

model Business {
  id                       String               @id @default(uuid())
  name                     String
  slug                     String               @unique
  businessType             String?
  description              String?
  timezone                 String
  defaultCurrency          String               @default("MXN")
  city                     String?
  state                    String?
  operationalScheduleJson  Json?
  operationalDayCutoffHour Int
  createdByUserId          String
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  createdBy                User                 @relation("BusinessCreator", fields: [createdByUserId], references: [id])
  memberships              BusinessMembership[]
  onboarding               BusinessOnboarding?
  inventoryLocations       InventoryLocation[]
  materials                Material[]
  products                 Product[]
  staffProfiles            StaffProfile[]
  payrollPayments          PayrollPayment[]
  notifications            Notification[]
  areas                    Area[]
  processTemplates         ProcessTemplate[]
  shiftLogs                ShiftLog[]
  rolePermissions          RolePermission[]
  roleCapabilities         BusinessRoleCapability[]
  paymentMethods           PaymentMethod[]
  sales                    Sale[]
  suppliers                Supplier[]
  purchaseOrders           PurchaseOrder[]
  receipts                 Receipt[]
  supplierInvoices         SupplierInvoice[]
  dailyOpenings            DailyInventoryOpening[]
  dailyClosings            DailyInventoryClosing[]
  deviationReports         DailyDeviationReport[]
  cashOpenings             DailyCashOpening[]
  cashReconciliations      DailyCashReconciliation[]
  dailyOperationCloses     DailyOperationClose[]
  dailyMasterArchives      DailyMasterArchive[]
}

model InventoryLocation {
  id                String                  @id @default(uuid())
  businessId        String
  name              String
  type              InventoryLocationType   @default(MAIN)
  isPrimary         Boolean                 @default(false)
  areaId            String?
  status            InventoryStatus         @default(ACTIVE)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  business          Business                @relation(fields: [businessId], references: [id])
  area              Area?                   @relation(fields: [areaId], references: [id])
  materialLots      MaterialLot[]
  materialMovements MaterialStockMovement[]
  productLots       ProductLot[]
  productMovements  ProductStockMovement[]
  receipts          Receipt[]
  dailyOpenings     DailyInventoryOpening[]
  dailyClosings     DailyInventoryClosing[]

  @@unique([businessId, name])
  @@index([businessId, status, createdAt])
}

model Material {
  id                       String                     @id @default(uuid())
  businessId               String
  name                     String
  baseUnit                 String
  kind                     MaterialKind               @default(RAW)
  category                 String?
  sku                      String?
  reorderFrequencyDays     Int?
  minStock                 Decimal                    @default(0) @db.Decimal(14, 4)
  currentStock             Decimal                    @default(0) @db.Decimal(14, 4)
  currentReferenceUnitCost Decimal                    @default(0) @db.Decimal(14, 4)
  status                   InventoryStatus            @default(ACTIVE)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  business                 Business                   @relation(fields: [businessId], references: [id])
  lots                     MaterialLot[]
  movements                MaterialStockMovement[]
  recipeItems              ProductRecipeVersionItem[]
  lotAllocations           MaterialLotAllocation[]
  theoreticalConsumptions  TheoreticalConsumption[]
  purchaseOrderItems       PurchaseOrderItem[]
  receiptItems             ReceiptItem[]
  openingItems             DailyInventoryOpeningItem[]
  closingItems             DailyInventoryClosingItem[]
  deviationItems           DeviationItem[]
  // FTI: recetas de producción donde ESTE material (TRANSFORMED) es la salida.
  productionRecipes        MaterialRecipe[]           @relation("MaterialRecipeOutput")
  // FTI: renglones de receta donde este material entra como insumo (crudo).
  materialRecipeItems      MaterialRecipeItem[]

  @@unique([businessId, name])
  @@unique([businessId, sku])
  @@index([businessId, status, createdAt])
}

model MaterialLot {
  id                String                  @id @default(uuid())
  businessId        String
  materialId        String
  locationId        String
  sourceType        InventoryLotSourceType
  lotCode           String?
  originalQuantity  Decimal                 @db.Decimal(14, 4)
  remainingQuantity Decimal                 @db.Decimal(14, 4)
  unitCost          Decimal                 @db.Decimal(14, 4)
  totalCost         Decimal                 @db.Decimal(14, 4)
  currency          String
  receivedAt        DateTime                @default(now())
  expiresAt         DateTime?
  referenceType     String?
  referenceId       String?
  note              String?
  createdByUserId   String?
  createdAt         DateTime                @default(now())
  material          Material                @relation(fields: [materialId], references: [id])
  location          InventoryLocation       @relation(fields: [locationId], references: [id])
  allocations       MaterialLotAllocation[]
  stockMovements    MaterialStockMovement[]
  receiptItems      ReceiptItem[]

  @@index([businessId, materialId, locationId, receivedAt])
  @@index([referenceType, referenceId])
}

model MaterialStockMovement {
  id                String                  @id @default(uuid())
  businessId        String
  materialId        String
  locationId        String
  lotId             String?
  type              InventoryMovementType
  quantityDelta     Decimal                 @db.Decimal(14, 4)
  balanceAfter      Decimal                 @db.Decimal(14, 4)
  unitCostSnapshot  Decimal?                @db.Decimal(14, 4)
  totalCostSnapshot Decimal?                @db.Decimal(14, 4)
  currency          String?
  referenceType     String?
  referenceId       String?
  note              String?
  createdByUserId   String?
  createdAt         DateTime                @default(now())
  material          Material                @relation(fields: [materialId], references: [id])
  location          InventoryLocation       @relation(fields: [locationId], references: [id])
  lot               MaterialLot?            @relation(fields: [lotId], references: [id])
  allocations       MaterialLotAllocation[]

  @@index([businessId, materialId, locationId, createdAt])
  @@index([referenceType, referenceId])
}

model MaterialLotAllocation {
  id                String                @id @default(uuid())
  businessId        String
  materialId        String
  lotId             String
  movementId        String
  quantity          Decimal               @db.Decimal(14, 4)
  unitCostSnapshot  Decimal               @db.Decimal(14, 4)
  totalCostSnapshot Decimal               @db.Decimal(14, 4)
  createdAt         DateTime              @default(now())
  material          Material              @relation(fields: [materialId], references: [id])
  lot               MaterialLot           @relation(fields: [lotId], references: [id])
  movement          MaterialStockMovement @relation(fields: [movementId], references: [id])

  @@unique([lotId, movementId])
  @@index([businessId, materialId, createdAt])
}

model Product {
  id                        String                     @id @default(uuid())
  businessId                String
  name                      String
  category                  String?
  type                      ProductType
  stockUnit                 String                     @default("unit")
  estimatedDailySalesVolume Decimal?                   @db.Decimal(14, 4)
  minStock                  Decimal                    @default(0) @db.Decimal(14, 4)
  makeToOrder               Boolean                    @default(false)
  currentStock              Decimal                    @default(0) @db.Decimal(14, 4)
  currentSalePrice          Decimal                    @default(0) @db.Decimal(14, 4)
  currentMaterialCost       Decimal                    @default(0) @db.Decimal(14, 4)
  currentDirectLaborCost    Decimal                    @default(0) @db.Decimal(14, 4)
  currentAllocatedCifCost   Decimal                    @default(0) @db.Decimal(14, 4)
  currentCost               Decimal                    @default(0) @db.Decimal(14, 4)
  status                    InventoryStatus            @default(ACTIVE)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  business                  Business                   @relation(fields: [businessId], references: [id])
  salePriceHistory          ProductSalePriceHistory[]
  manualCostHistory         ProductManualCostHistory[]
  recipeVersions            ProductRecipeVersion[]
  lots                      ProductLot[]
  movements                 ProductStockMovement[]
  lotAllocations            ProductLotAllocation[]
  saleItems                 SaleItem[]

  @@unique([businessId, name])
  @@index([businessId, status, createdAt])
}

model ProductSalePriceHistory {
  id              String   @id @default(uuid())
  businessId      String
  productId       String
  price           Decimal  @db.Decimal(14, 4)
  currency        String
  effectiveFrom   DateTime @default(now())
  createdByUserId String?
  changeReason    String?
  createdAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id])

  @@index([productId, effectiveFrom])
}

model ProductManualCostHistory {
  id               String   @id @default(uuid())
  businessId       String
  productId        String
  materialCost     Decimal  @default(0) @db.Decimal(14, 4)
  directLaborCost  Decimal  @default(0) @db.Decimal(14, 4)
  allocatedCifCost Decimal  @default(0) @db.Decimal(14, 4)
  totalCost        Decimal  @db.Decimal(14, 4)
  effectiveFrom    DateTime @default(now())
  createdByUserId  String?
  changeReason     String?
  createdAt        DateTime @default(now())
  product          Product  @relation(fields: [productId], references: [id])

  @@index([productId, effectiveFrom])
}

model ProductRecipeVersion {
  id               String                     @id @default(uuid())
  businessId       String
  productId        String
  versionNumber    Int
  effectiveFrom    DateTime                   @default(now())
  materialCost     Decimal                    @default(0) @db.Decimal(14, 4)
  directLaborCost  Decimal                    @default(0) @db.Decimal(14, 4)
  allocatedCifCost Decimal                    @default(0) @db.Decimal(14, 4)
  totalCost        Decimal                    @default(0) @db.Decimal(14, 4)
  note             String?
  createdByUserId  String?
  createdAt        DateTime                   @default(now())
  product                  Product                    @relation(fields: [productId], references: [id])
  items                    ProductRecipeVersionItem[]
  saleItems                SaleItem[]
  theoreticalConsumptions  TheoreticalConsumption[]

  @@unique([productId, versionNumber])
  @@index([productId, effectiveFrom])
}

model ProductRecipeVersionItem {
  id              String               @id @default(uuid())
  recipeVersionId String
  materialId      String
  quantity        Decimal              @db.Decimal(14, 4)
  wastePercent    Decimal              @default(0) @db.Decimal(7, 4)
  createdAt       DateTime             @default(now())
  recipeVersion   ProductRecipeVersion @relation(fields: [recipeVersionId], references: [id])
  material        Material             @relation(fields: [materialId], references: [id])

  @@unique([recipeVersionId, materialId])
}

// FTI (Formato de Transformación Interna) — receta de producción de un insumo
// TRANSFORMED (carne marinada, aderezos). Versionada, igual que las recetas de
// producto. `outputMaterial` es el semi-elaborado que se produce; los `items`
// son los insumos crudos que se consumen. `outputQuantity` = cuánto rinde la
// receta base (ej. la receta produce 1 kg de marinada).
model MaterialRecipe {
  id               String               @id @default(uuid())
  businessId       String
  outputMaterialId String
  versionNumber    Int
  outputQuantity   Decimal              @default(1) @db.Decimal(14, 4)
  effectiveFrom    DateTime             @default(now())
  materialCost     Decimal              @default(0) @db.Decimal(14, 4)
  note             String?
  createdByUserId  String?
  createdAt        DateTime             @default(now())
  outputMaterial   Material             @relation("MaterialRecipeOutput", fields: [outputMaterialId], references: [id])
  items            MaterialRecipeItem[]

  @@unique([outputMaterialId, versionNumber])
  @@index([businessId, outputMaterialId, effectiveFrom])
}

model MaterialRecipeItem {
  id               String         @id @default(uuid())
  materialRecipeId String
  materialId       String
  quantity         Decimal        @db.Decimal(14, 4)
  wastePercent     Decimal        @default(0) @db.Decimal(7, 4)
  createdAt        DateTime       @default(now())
  materialRecipe   MaterialRecipe @relation(fields: [materialRecipeId], references: [id])
  material         Material       @relation(fields: [materialId], references: [id])

  @@unique([materialRecipeId, materialId])
}

model ProductLot {
  id                String                 @id @default(uuid())
  businessId        String
  productId         String
  locationId        String
  sourceType        InventoryLotSourceType
  originalQuantity  Decimal                @db.Decimal(14, 4)
  remainingQuantity Decimal                @db.Decimal(14, 4)
  materialCost      Decimal                @default(0) @db.Decimal(14, 4)
  directLaborCost   Decimal                @default(0) @db.Decimal(14, 4)
  allocatedCifCost  Decimal                @default(0) @db.Decimal(14, 4)
  totalUnitCost     Decimal                @db.Decimal(14, 4)
  totalLotCost      Decimal                @db.Decimal(14, 4)
  currency          String
  producedAt        DateTime               @default(now())
  referenceType     String?
  referenceId       String?
  note              String?
  createdByUserId   String?
  createdAt         DateTime               @default(now())
  product           Product                @relation(fields: [productId], references: [id])
  location          InventoryLocation      @relation(fields: [locationId], references: [id])
  allocations       ProductLotAllocation[]
  stockMovements    ProductStockMovement[]

  @@index([businessId, productId, locationId, producedAt])
  @@index([referenceType, referenceId])
}

model ProductStockMovement {
  id                       String                 @id @default(uuid())
  businessId               String
  productId                String
  locationId               String
  lotId                    String?
  type                     InventoryMovementType
  quantityDelta            Decimal                @db.Decimal(14, 4)
  balanceAfter             Decimal                @db.Decimal(14, 4)
  materialCostSnapshot     Decimal?               @db.Decimal(14, 4)
  directLaborCostSnapshot  Decimal?               @db.Decimal(14, 4)
  allocatedCifCostSnapshot Decimal?               @db.Decimal(14, 4)
  totalUnitCostSnapshot    Decimal?               @db.Decimal(14, 4)
  totalCostSnapshot        Decimal?               @db.Decimal(14, 4)
  currency                 String?
  referenceType            String?
  referenceId              String?
  note                     String?
  createdByUserId          String?
  createdAt                DateTime               @default(now())
  product                  Product                @relation(fields: [productId], references: [id])
  location                 InventoryLocation      @relation(fields: [locationId], references: [id])
  lot                      ProductLot?            @relation(fields: [lotId], references: [id])
  allocations              ProductLotAllocation[]

  @@index([businessId, productId, locationId, createdAt])
  @@index([referenceType, referenceId])
}

model ProductLotAllocation {
  id                       String               @id @default(uuid())
  businessId               String
  productId                String
  lotId                    String
  movementId               String
  quantity                 Decimal              @db.Decimal(14, 4)
  materialCostSnapshot     Decimal              @default(0) @db.Decimal(14, 4)
  directLaborCostSnapshot  Decimal              @default(0) @db.Decimal(14, 4)
  allocatedCifCostSnapshot Decimal              @default(0) @db.Decimal(14, 4)
  totalUnitCostSnapshot    Decimal              @db.Decimal(14, 4)
  totalCostSnapshot        Decimal              @db.Decimal(14, 4)
  createdAt                DateTime             @default(now())
  product                  Product              @relation(fields: [productId], references: [id])
  lot                      ProductLot           @relation(fields: [lotId], references: [id])
  movement                 ProductStockMovement @relation(fields: [movementId], references: [id])

  @@unique([lotId, movementId])
  @@index([businessId, productId, createdAt])
}

model BusinessMembership {
  id              String           @id @default(uuid())
  businessId      String
  userId          String
  role            MembershipRole
  status          MembershipStatus @default(ACTIVE)
  invitedByUserId String?
  joinedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  business        Business         @relation(fields: [businessId], references: [id])
  user            User             @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
}

model BusinessOnboarding {
  id                   String           @id @default(uuid())
  businessId           String           @unique
  status               OnboardingStatus @default(DRAFT)
  currentStep          String           @default("general_info")
  completionPercentage Int              @default(0)
  generalInfoCompleted Boolean          @default(false)
  staffCompleted       Boolean          @default(false)
  productsCompleted    Boolean          @default(false)
  ingredientsCompleted Boolean          @default(false)
  recipesCompleted     Boolean          @default(false)
  fixedCostsCompleted  Boolean          @default(false)
  areasCompleted       Boolean          @default(false)
  providersCompleted   Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  business             Business         @relation(fields: [businessId], references: [id])
}

model StaffProfile {
  id                String            @id @default(uuid())
  businessId        String
  userId            String?           @unique
  fullName          String
  phoneNumber       String?
  email             String?
  operationalRole   String
  assignedAreasJson Json?
  shift             String?
  systemAccessLevel SystemAccessLevel @default(NONE)
  username          String?
  status            StaffStatus       @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  business            Business                   @relation(fields: [businessId], references: [id])
  compensation        StaffCompensation?
  compensationHistory StaffCompensationHistory[]
  payrollPayments     PayrollPayment[]
  shiftLogs           ShiftLog[]
  sales               Sale[]

  @@unique([businessId, username])
  @@index([businessId, status])
}

model StaffCompensation {
  id                   String           @id @default(uuid())
  staffProfileId       String           @unique
  salaryAmount         Decimal          @db.Decimal(10, 2)
  salaryCurrency       String           @default("MXN")
  payrollFrequency     PayrollFrequency
  firstPaymentDate     DateTime         @db.Date
  weeklyPayDay         Int?
  monthlyPayDay        Int?
  semimonthlyFirstDay  Int?
  semimonthlySecondDay Int?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id])
}

model StaffCompensationHistory {
  id                   String           @id @default(uuid())
  staffProfileId       String
  salaryAmount         Decimal          @db.Decimal(10, 2)
  salaryCurrency       String           @default("MXN")
  payrollFrequency     PayrollFrequency
  firstPaymentDate     DateTime         @db.Date
  weeklyPayDay         Int?
  monthlyPayDay        Int?
  semimonthlyFirstDay  Int?
  semimonthlySecondDay Int?
  effectiveFrom        DateTime         @default(now())
  createdByUserId      String?
  changeReason         String?
  createdAt            DateTime         @default(now())

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id])

  @@index([staffProfileId, effectiveFrom])
}

model PayrollPayment {
  id               String               @id @default(uuid())
  businessId       String
  staffProfileId   String
  amount           Decimal              @db.Decimal(10, 2)
  currency         String               @default("MXN")
  payrollFrequency PayrollFrequency
  dueDate          DateTime             @db.Date
  status           PayrollPaymentStatus @default(PENDING)
  paidAt           DateTime?
  paidByUserId     String?
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  business     Business     @relation(fields: [businessId], references: [id])
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id])

  @@unique([staffProfileId, dueDate])
  @@index([businessId, dueDate, status])
  @@index([staffProfileId, status, dueDate])
}

model Notification {
  id           String             @id @default(uuid())
  businessId   String
  type         NotificationType
  title        String
  body         String
  status       NotificationStatus @default(UNREAD)
  dedupeKey    String             @unique
  resourceType String?
  resourceId   String?
  scheduledFor DateTime?          @db.Date
  readAt       DateTime?
  readByUserId String?
  metadataJson Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, status, createdAt])
  @@index([resourceType, resourceId])
}

// ──────────────────────────────────────────────
// Phase 1 models: Areas, Processes, Time Tracking
// ──────────────────────────────────────────────

model Area {
  id           String     @id @default(uuid())
  businessId   String
  name         String
  type         AreaType   @default(OTHER)
  description  String?
  parentAreaId String?
  status       AreaStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  business           Business            @relation(fields: [businessId], references: [id])
  parentArea         Area?               @relation("AreaHierarchy", fields: [parentAreaId], references: [id])
  childAreas         Area[]              @relation("AreaHierarchy")
  inventoryLocations InventoryLocation[]
  processSteps       ProcessStep[]
  processExecutions  ProcessExecution[]
  shiftLogs          ShiftLog[]
  sales              Sale[]
  rolePermissions    RolePermission[]

  @@unique([businessId, name])
  @@index([businessId, status, createdAt])
}

model ProcessTemplate {
  id          String        @id @default(uuid())
  businessId  String
  name        String
  description String?
  isBlocking  Boolean       @default(false)
  status      ProcessStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business   Business           @relation(fields: [businessId], references: [id])
  steps      ProcessStep[]
  executions ProcessExecution[]
  rolePermissions RolePermission[]

  @@unique([businessId, name])
  @@index([businessId, status])
}

model ProcessStep {
  id             String          @id @default(uuid())
  processId      String
  name           String
  description    String?
  stepOrder      Int
  requiredRole   MembershipRole?
  assignedAreaId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  process      ProcessTemplate @relation(fields: [processId], references: [id], onDelete: Cascade)
  assignedArea Area?           @relation(fields: [assignedAreaId], references: [id])

  @@unique([processId, stepOrder])
  @@index([processId])
}

model ProcessExecution {
  id               String                 @id @default(uuid())
  businessId       String
  processId        String
  areaId           String?
  executedByUserId String
  startedAt        DateTime               @default(now())
  completedAt      DateTime?
  status           ProcessExecutionStatus @default(PENDING)
  notesJson        Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  process ProcessTemplate @relation(fields: [processId], references: [id])
  area    Area?           @relation(fields: [areaId], references: [id])

  @@index([businessId, processId, startedAt])
  @@index([businessId, status])
}

model ShiftLog {
  id               String         @id @default(uuid())
  businessId       String
  staffProfileId   String
  areaId           String?
  clockInAt        DateTime       @default(now())
  clockOutAt       DateTime?
  clockInLatitude  Decimal?       @db.Decimal(10, 7)
  clockInLongitude Decimal?       @db.Decimal(10, 7)
  clockOutLatitude  Decimal?      @db.Decimal(10, 7)
  clockOutLongitude Decimal?      @db.Decimal(10, 7)
  totalMinutes     Int?
  status           ShiftLogStatus @default(ACTIVE)
  note             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  business     Business     @relation(fields: [businessId], references: [id])
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id])
  area         Area?        @relation(fields: [areaId], references: [id])
  breaks       ShiftBreak[]

  @@index([businessId, staffProfileId, clockInAt])
  @@index([businessId, clockInAt])
}

model ShiftBreak {
  id         String         @id @default(uuid())
  shiftLogId String
  startAt    DateTime       @default(now())
  endAt      DateTime?
  type       ShiftBreakType @default(REST)
  minutes    Int?
  createdAt  DateTime       @default(now())

  shiftLog ShiftLog @relation(fields: [shiftLogId], references: [id], onDelete: Cascade)

  @@index([shiftLogId])
}

model RolePermission {
  id         String           @id @default(uuid())
  businessId String
  role       MembershipRole
  areaId     String?
  processId  String?
  permission PermissionAction
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  business Business         @relation(fields: [businessId], references: [id])
  area     Area?            @relation(fields: [areaId], references: [id])
  process  ProcessTemplate? @relation(fields: [processId], references: [id])

  @@unique([businessId, role, areaId, processId, permission])
  @@index([businessId, role])
}

// Override de capacidades por negocio (permisos configurables por R6).
// Semántica: si un negocio tiene filas para un rol, esas filas DEFINEN sus
// capacidades (reemplazan el default de capabilities.ts para ese rol). Si no
// hay filas para un rol, se usa el default en código. `allowed=false` permite
// revocar una capacidad explícitamente. Ver PermissionService.
model BusinessRoleCapability {
  id         String         @id @default(uuid())
  businessId String
  role       MembershipRole
  capability String
  allowed    Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, role, capability])
  @@index([businessId, role])
}

// ──────────────────────────────────────────────
// Phase 2 models: Sales & POS
// ──────────────────────────────────────────────

model PaymentMethod {
  id                String              @id @default(uuid())
  businessId        String
  name              String
  type              PaymentMethodType
  terminalReference String?
  bankReference     String?
  status            PaymentMethodStatus @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  business                 Business                 @relation(fields: [businessId], references: [id])
  salePayments             SalePayment[]
  terminalReconciliations  TerminalReconciliation[]

  @@unique([businessId, name])
  @@index([businessId, status])
}

model Sale {
  id                 String     @id @default(uuid())
  businessId         String
  areaId             String?
  operatorStaffId    String
  saleNumber         Int
  subtotal           Decimal    @db.Decimal(14, 4)
  taxAmount          Decimal    @default(0) @db.Decimal(14, 4)
  total              Decimal    @db.Decimal(14, 4)
  status             SaleStatus @default(OPEN)
  cancelledByUserId  String?
  cancellationReason String?
  completedAt        DateTime?
  cancelledAt        DateTime?
  note               String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  business                Business                 @relation(fields: [businessId], references: [id])
  area                    Area?                    @relation(fields: [areaId], references: [id])
  operator                StaffProfile             @relation(fields: [operatorStaffId], references: [id])
  items                   SaleItem[]
  payments                SalePayment[]
  theoreticalConsumptions TheoreticalConsumption[]

  @@unique([businessId, saleNumber])
  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([businessId, areaId, createdAt])
}

model SaleItem {
  id              String   @id @default(uuid())
  saleId          String
  productId       String
  quantity        Decimal  @db.Decimal(14, 4)
  unitPrice       Decimal  @db.Decimal(14, 4)
  totalPrice      Decimal  @db.Decimal(14, 4)
  costSnapshot    Decimal  @default(0) @db.Decimal(14, 4)
  recipeVersionId String?
  createdAt       DateTime @default(now())

  sale                    Sale                     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product                 Product                  @relation(fields: [productId], references: [id])
  recipeVersion           ProductRecipeVersion?    @relation(fields: [recipeVersionId], references: [id])
  theoreticalConsumptions TheoreticalConsumption[]

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id              String   @id @default(uuid())
  saleId          String
  paymentMethodId String
  amount          Decimal  @db.Decimal(14, 4)
  reference       String?
  createdAt       DateTime @default(now())

  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([saleId])
  @@index([paymentMethodId])
}

model TheoreticalConsumption {
  id               String   @id @default(uuid())
  businessId       String
  saleId           String
  saleItemId       String
  materialId       String
  recipeVersionId  String
  productQuantity  Decimal  @db.Decimal(14, 4)
  recipeQuantity   Decimal  @db.Decimal(14, 4)
  wastePercent     Decimal  @default(0) @db.Decimal(7, 4)
  expectedQuantity Decimal  @db.Decimal(14, 4)
  unitCostSnapshot Decimal  @default(0) @db.Decimal(14, 4)
  expectedCost     Decimal  @default(0) @db.Decimal(14, 4)
  calculatedAt     DateTime @default(now())

  sale          Sale                 @relation(fields: [saleId], references: [id])
  saleItem      SaleItem             @relation(fields: [saleItemId], references: [id])
  material      Material             @relation(fields: [materialId], references: [id])
  recipeVersion ProductRecipeVersion @relation(fields: [recipeVersionId], references: [id])

  @@index([businessId, saleId])
  @@index([businessId, materialId, calculatedAt])
  @@index([saleItemId])
}

// ── Phase 3: Supply Chain ──────────────────────────────────────────────

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ReceiptStatus {
  DRAFT
  PENDING_REVIEW
  COMPLETED
  PARTIAL
  CANCELLED
  REJECTED
}

enum SupplierInvoiceStatus {
  PENDING
  VERIFIED
  DISPUTED
  DELETED
}

model Supplier {
  id          String         @id @default(uuid())
  businessId  String
  name        String
  contactName String?
  email       String?
  phone       String?
  rfc         String?
  address     String?
  notes       String?
  status      SupplierStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  business       Business          @relation(fields: [businessId], references: [id])
  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]

  @@unique([businessId, name])
  @@unique([businessId, rfc])
  @@index([businessId, status])
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  businessId      String
  supplierId      String
  createdByUserId String
  orderNumber     Int
  status          PurchaseOrderStatus @default(DRAFT)
  totalEstimated  Decimal             @default(0) @db.Decimal(14, 4)
  currency        String              @default("MXN")
  notes           String?
  sentAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  business  Business            @relation(fields: [businessId], references: [id])
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation("PurchaseOrderCreator", fields: [createdByUserId], references: [id])
  items     PurchaseOrderItem[]
  receipts  Receipt[]

  @@index([businessId, status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id                String  @id @default(uuid())
  purchaseOrderId   String
  materialId        String
  quantityOrdered   Decimal @db.Decimal(14, 4)
  estimatedUnitCost Decimal @db.Decimal(14, 4)
  notes             String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])

  @@index([purchaseOrderId])
}

model Receipt {
  id                  String        @id @default(uuid())
  businessId          String
  purchaseOrderId     String?
  receivedByUserId    String
  locationId          String
  status              ReceiptStatus @default(COMPLETED)
  notes               String?
  cancellationReason  String?
  cancellationComment String?
  cancelledByUserId   String?
  cancelledAt         DateTime?
  authorizedByUserId  String?
  authorizedAt        DateTime?
  rejectedByUserId    String?
  rejectedAt          DateTime?
  rejectionReason     String?
  receivedAt          DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  business      Business          @relation(fields: [businessId], references: [id])
  purchaseOrder PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User              @relation("ReceiptReceiver", fields: [receivedByUserId], references: [id])
  cancelledBy   User?             @relation("ReceiptCanceller", fields: [cancelledByUserId], references: [id])
  authorizedBy  User?             @relation("ReceiptAuthorizer", fields: [authorizedByUserId], references: [id])
  rejectedBy    User?             @relation("ReceiptRejecter", fields: [rejectedByUserId], references: [id])
  location      InventoryLocation @relation(fields: [locationId], references: [id])
  items         ReceiptItem[]
  invoice       SupplierInvoice?

  @@index([businessId])
  @@index([businessId, status])
  @@index([purchaseOrderId])
}

model ReceiptItem {
  id               String  @id @default(uuid())
  receiptId        String
  materialId       String
  quantityReceived Decimal @db.Decimal(14, 4)
  actualUnitCost   Decimal @db.Decimal(14, 4)
  lotId            String?

  receipt  Receipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  material Material     @relation(fields: [materialId], references: [id])
  lot      MaterialLot? @relation(fields: [lotId], references: [id])

  @@index([receiptId])
}

model SupplierInvoice {
  id                String                @id @default(uuid())
  businessId        String
  supplierId        String
  receiptId         String?               @unique
  cfdiUuid          String?
  cfdiXml           String?
  totalAmount       Decimal               @db.Decimal(14, 4)
  receiptTotal      Decimal?              @db.Decimal(14, 4)
  discrepancyNote   String?
  currency          String                @default("MXN")
  invoiceDate       DateTime
  status            SupplierInvoiceStatus @default(PENDING)
  verifiedByUserId  String?
  verifiedAt        DateTime?
  deletedByUserId   String?
  deletedAt         DateTime?
  deletionReason    String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  business   Business @relation(fields: [businessId], references: [id])
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  receipt    Receipt? @relation(fields: [receiptId], references: [id])
  verifiedBy User?    @relation("InvoiceVerifier", fields: [verifiedByUserId], references: [id])
  deletedBy  User?    @relation("InvoiceDeleter", fields: [deletedByUserId], references: [id])

  @@index([businessId, status])
  @@index([supplierId])
}

// ── Phase 4: Cadena Diaria (FAI → FCI → FID → FAF → FOP) ────────────

enum DailyOpeningStatus {
  PENDING
  AUTHORIZED
  REJECTED
}

enum DailyClosingStatus {
  PENDING
  AUTHORIZED
  REJECTED
  COMPLETED
}

enum DeviationReportStatus {
  PENDING_CLASSIFICATION
  CLASSIFIED
  APPROVED
}

enum DeviationCause {
  ERROR
  WASTE
  THEFT
  ADJUSTMENT
  OVERPRODUCTION
  UNDERPRODUCTION
  OTHER
}

enum ReconciliationStatus {
  PENDING
  PENDING_REVIEW
  RECONCILED
  DISCREPANCY
  REJECTED
}

enum DailyOperationStatus {
  PENDING
  SIGNED
  BLOCKED
}

enum FOPValidationType {
  INVENTORY
  CASH
  PROCESSES
  HOURS
}

// 4.1 FAI — Apertura de Inventario

model DailyInventoryOpening {
  id                  String              @id @default(uuid())
  businessId          String
  locationId          String
  operationalDate     DateTime            @db.Date
  status              DailyOpeningStatus  @default(PENDING)
  authorizedByUserId  String?
  authorizedAt        DateTime?
  rejectedReason      String?
  createdByUserId     String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  business    Business                    @relation(fields: [businessId], references: [id])
  location    InventoryLocation           @relation(fields: [locationId], references: [id])
  items       DailyInventoryOpeningItem[]

  @@index([businessId, locationId, operationalDate])
  @@index([businessId, operationalDate])
}

model DailyInventoryOpeningItem {
  id                      String  @id @default(uuid())
  openingId               String
  materialId              String
  countedQuantity         Decimal @db.Decimal(14, 4)
  previousClosingQuantity Decimal @default(0) @db.Decimal(14, 4)
  systemQuantity          Decimal @default(0) @db.Decimal(14, 4)
  variance                Decimal @default(0) @db.Decimal(14, 4)
  varianceValueMXN        Decimal @default(0) @db.Decimal(14, 4)
  varianceNote            String?

  opening  DailyInventoryOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)
  material Material              @relation(fields: [materialId], references: [id])

  @@unique([openingId, materialId])
}

// 4.2 FCI — Cierre de Inventario

model DailyInventoryClosing {
  id                  String              @id @default(uuid())
  businessId          String
  locationId          String
  operationalDate     DateTime            @db.Date
  status              DailyClosingStatus  @default(PENDING)
  completedByUserId   String?
  completedAt         DateTime?
  authorizedByUserId  String?
  authorizedAt        DateTime?
  rejectedReason      String?
  createdByUserId     String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  business    Business                    @relation(fields: [businessId], references: [id])
  location    InventoryLocation           @relation(fields: [locationId], references: [id])
  items       DailyInventoryClosingItem[]

  @@index([businessId, locationId, operationalDate])
  @@index([businessId, operationalDate])
}

model DailyInventoryClosingItem {
  id                String  @id @default(uuid())
  closingId         String
  materialId        String
  countedQuantity   Decimal @db.Decimal(14, 4)
  openingQuantity   Decimal @default(0) @db.Decimal(14, 4)
  receivedQuantity  Decimal @default(0) @db.Decimal(14, 4)
  realConsumption   Decimal @default(0) @db.Decimal(14, 4)

  closing  DailyInventoryClosing @relation(fields: [closingId], references: [id], onDelete: Cascade)
  material Material              @relation(fields: [materialId], references: [id])

  @@unique([closingId, materialId])
}

// 4.3 FID — Desviaciones

model DailyDeviationReport {
  id                      String                @id @default(uuid())
  businessId              String
  operationalDate         DateTime              @db.Date
  status                  DeviationReportStatus @default(PENDING_CLASSIFICATION)
  totalDeviationValueMXN  Decimal               @default(0) @db.Decimal(14, 4)
  approvedByUserId        String?
  approvedAt              DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  business Business        @relation(fields: [businessId], references: [id])
  items    DeviationItem[]

  @@unique([businessId, operationalDate])
  @@index([businessId, operationalDate])
}

model DeviationItem {
  id                      String          @id @default(uuid())
  reportId                String
  materialId              String
  theoreticalConsumption  Decimal         @db.Decimal(14, 4)
  realConsumption         Decimal         @db.Decimal(14, 4)
  deviationQuantity       Decimal         @db.Decimal(14, 4)
  deviationValueMXN       Decimal         @db.Decimal(14, 4)
  cause                   DeviationCause?
  classifiedByUserId      String?
  note                    String?

  report   DailyDeviationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  material Material              @relation(fields: [materialId], references: [id])

  @@unique([reportId, materialId])
}

// 4.4.0 Saldo inicial de caja — candado C2
// R2 declara el efectivo con el que abre la caja ANTES de la 1ª venta. El FAF
// parte de este saldo (efectivo esperado = saldo inicial + ventas en efectivo).
// Uno por negocio y fecha operativa.

model DailyCashOpening {
  id                 String   @id @default(uuid())
  businessId         String
  operationalDate    DateTime @db.Date
  openingBalance     Decimal  @db.Decimal(14, 4)
  notes              String?
  declaredByUserId   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, operationalDate])
  @@index([businessId, operationalDate])
}

// 4.4 FAF — Arqueo Financiero

model DailyCashReconciliation {
  id                  String               @id @default(uuid())
  businessId          String
  operationalDate     DateTime             @db.Date
  status              ReconciliationStatus @default(PENDING)
  totalExpected       Decimal              @default(0) @db.Decimal(14, 4)
  totalCounted        Decimal              @default(0) @db.Decimal(14, 4)
  difference          Decimal              @default(0) @db.Decimal(14, 4)
  reconciledByUserId  String?
  reconciledAt        DateTime?
  approvedByUserId    String?
  approvedAt          DateTime?
  rejectedByUserId    String?
  rejectedAt          DateTime?
  rejectedReason      String?
  createdByUserId     String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  business                Business                  @relation(fields: [businessId], references: [id])
  cashDenominations       CashDenominationCount[]
  terminalReconciliations TerminalReconciliation[]
  transferReconciliations TransferReconciliation[]

  @@index([businessId, operationalDate])
}

model CashDenominationCount {
  id                String  @id @default(uuid())
  reconciliationId  String
  denomination      Decimal @db.Decimal(10, 2)
  quantity          Int
  subtotal          Decimal @db.Decimal(14, 4)

  reconciliation DailyCashReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@unique([reconciliationId, denomination])
}

model TerminalReconciliation {
  id                String  @id @default(uuid())
  reconciliationId  String
  paymentMethodId   String
  expectedTotal     Decimal @db.Decimal(14, 4)
  reportedTotal     Decimal @db.Decimal(14, 4)
  reference         String?
  difference        Decimal @db.Decimal(14, 4)

  reconciliation DailyCashReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  paymentMethod  PaymentMethod           @relation(fields: [paymentMethodId], references: [id])

  @@unique([reconciliationId, paymentMethodId])
}

model TransferReconciliation {
  id                String  @id @default(uuid())
  reconciliationId  String
  expectedTotal     Decimal @db.Decimal(14, 4)
  reportedTotal     Decimal @db.Decimal(14, 4)
  folioReferences   String?
  difference        Decimal @db.Decimal(14, 4)

  reconciliation DailyCashReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
}

// 4.5 FOP — Operacion y Procesos

model DailyOperationClose {
  id                       String               @id @default(uuid())
  businessId               String
  operationalDate          DateTime             @db.Date
  status                   DailyOperationStatus @default(PENDING)
  signedByUserId           String?
  signedAt                 DateTime?
  signedWithDiscrepancy    Boolean              @default(false)
  discrepancyJustification String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  business        Business              @relation(fields: [businessId], references: [id])
  validationItems FOPValidationItem[]
  amd             DailyMasterArchive?

  @@unique([businessId, operationalDate])
  @@index([businessId, operationalDate])
}

model FOPValidationItem {
  id                String            @id @default(uuid())
  fopId             String
  validationType    FOPValidationType
  label             String
  operatorValue     Decimal           @db.Decimal(14, 4)
  systemValue       Decimal           @db.Decimal(14, 4)
  difference        Decimal           @db.Decimal(14, 4)
  isWithinThreshold Boolean           @default(false)
  resolution        String?

  fop DailyOperationClose @relation(fields: [fopId], references: [id], onDelete: Cascade)

  @@index([fopId])
}

// ── Phase 5 — AMD (Archivo Maestro Diario) ──────────────────────────
// Documento inmutable generado automaticamente al firmar el FOP. Sellado
// con SHA-256 sobre JSON canonico (RFC 8785). Cualquier modificacion
// posterior produce hash distinto — manipulacion matematicamente
// detectable. Detalles en INVENTORY_COSTING.md y ARCHITECTURE_V3.md.

enum AMDStatus {
  GENERATED
  VERIFIED
  TAMPERED
}

model DailyMasterArchive {
  id              String    @id @default(uuid())
  businessId      String
  operationalDate DateTime  @db.Date
  fopId           String    @unique
  contentJson     Json
  contentHash     String
  schemaVersion   Int       @default(1)
  generatedAt     DateTime  @default(now())
  status          AMDStatus @default(GENERATED)

  business Business            @relation(fields: [businessId], references: [id])
  fop      DailyOperationClose @relation(fields: [fopId], references: [id])

  @@unique([businessId, operationalDate])
  @@index([businessId, operationalDate])
}
