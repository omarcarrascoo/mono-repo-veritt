              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (Array.isArray(jsonData) && jsonData.length > 0) {",
                  "  var primary = jsonData.find(function(item) { return item.isPrimary; }) || jsonData[0];",
                  "  if (primary && primary.id) { pm.collectionVariables.set('locationId', primary.id); }",
                  "  var warehouse = jsonData.find(function(item) { return item.type === 'WAREHOUSE'; });",
                  "  if (warehouse && warehouse.id) { pm.collectionVariables.set('warehouseLocationId', warehouse.id); }",
                  "}"
                ]
              }
